BINGOMATE_LOCAL_LLM_MAX_TOKENS=512
BINGOMATE_STT_ENABLED=0
BINGOMATE_STT_PROVIDER=openai-compatible
BINGOMATE_STT_URL=
BINGOMATE_STT_MODEL=
BINGOMATE_STT_COMMAND=
BINGOMATE_STT_TIMEOUT_SECONDS=30
BINGOMATE_MQTT_HOST=
BINGOMATE_MQTT_PORT=1883
BINGOMATE_MQTT_TOPIC=bingomate/devices
BINGOMATE_MQTT_USERNAME=
BINGOMATE_MQTT_PASSWORD=
