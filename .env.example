EDGE_LAB_MQTT_TOPIC=edge-impact-lab
EDGE_LAB_MQTT_USERNAME=
EDGE_LAB_MQTT_PASSWORD=
EDGE_LAB_RISK_PROFILE=
BINGOMATE_HOST=127.0.0.1
BINGOMATE_PORT=8090
BINGOMATE_DATA_DIR=data
BINGOMATE_MEMORY_DB=data/bingomate.db
BINGOMATE_SKILLS_DB=data/bingomate_skills.db
BINGOMATE_DEVICES_DB=data/bingomate_devices.db
BINGOMATE_DASHBOARD_DIR=apps/dashboard
BINGOMATE_DISPLAY_DIR=apps/bingo_display
BINGOMATE_DISPLAY_URL=http://127.0.0.1:8090/display
# Optional hash-token for local kiosk API calls. Prefer binding to 127.0.0.1 for boot display.
# BINGOMATE_DISPLAY_TOKEN=
BINGOMATE_AUTH_TOKEN=
BINGOMATE_MEMORY_KEY=
# Optional. Defaults to BINGOMATE_MEMORY_KEY when unset.
BINGOMATE_DEVICE_KEY=
BINGOMATE_CAMERA_ENABLED=0
BINGOMATE_CAMERA_INDEX=0
BINGOMATE_LOCAL_LLM_ENABLED=0
BINGOMATE_LOCAL_LLM_PROVIDER=openai-compatible
