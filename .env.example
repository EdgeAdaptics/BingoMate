LAB_WIFI_SSID=simple_reuse
LAB_WIFI_PASSWORD=
EDGE_LAB_SENSOR_PORT=/dev/ttyACM0
EDGE_LAB_MATRIX_PORT=/dev/ttyUSB0
EDGE_LAB_HTTP_PORT=8088
EDGE_LAB_MQTT_HOST=
